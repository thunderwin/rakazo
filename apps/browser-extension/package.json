{
  "name": "@rakazo/browser-extension",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:store": "NODE_ENV=production node scripts/build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/browser-extension/src",
    "test:e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@rakazo/browser-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
