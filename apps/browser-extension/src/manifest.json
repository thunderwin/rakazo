{
  "manifest_version": 3,
  "name": "ericBot Browser Bridge",
  "version": "0.1.0",
  "description": "Let the local ericBot client operate websites with your existing Chrome login state.",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "scripting", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ericBot Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
